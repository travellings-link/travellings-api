# Copy to mvp/random/.env. The production .env is not loaded.
RANDOM_MVP_HOST=127.0.0.1
RANDOM_MVP_PORT=14515

# A dedicated account with SELECT on <database>.webs only.
RANDOM_MVP_DB_HOST=127.0.0.1
RANDOM_MVP_DB_PORT=3306
RANDOM_MVP_DB_NAME=travellings
RANDOM_MVP_DB_USER=travellings_random_readonly
RANDOM_MVP_DB_PASSWORD=replace-with-readonly-password
RANDOM_MVP_DB_POOL_MAX=4
RANDOM_MVP_QUERY_TIMEOUT_MS=2000
# Hard client deadline per MySQL operation; expires by destroying its socket.
RANDOM_MVP_QUERY_CLIENT_TIMEOUT_MS=3000
RANDOM_MVP_MAX_IN_FLIGHT=8

# Dedicated MVP Redis connection. DB 5 is enforced; no production DB 0 client.
RANDOM_MVP_REDIS_HOST=127.0.0.1
RANDOM_MVP_REDIS_PORT=6379
RANDOM_MVP_REDIS_USERNAME=
RANDOM_MVP_REDIS_PASSWORD=
RANDOM_MVP_REDIS_DB=5
RANDOM_MVP_REDIS_TIMEOUT_MS=1000
RANDOM_MVP_CACHE_TTL_SECONDS=30

# Explicitly set true for HTTPS deployment, including TLS-terminating proxies.
RANDOM_MVP_COOKIE_SECURE=false
